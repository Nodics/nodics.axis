{
  "name": "nodics.axis",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Axis frontend for Nodics modular customer projects",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <23 || >=24 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:live": "node scripts/axis-live-smoke.mjs",
    "test": "vitest run",
    "test:commerce": "vitest run --run test/workbench/detail/WorkbenchRecordDetail.test.tsx test/workbench/api/workbenchClient.test.ts test/orderLifecycle/OrderLifecycleManagementRoutePage.test.tsx src/operations/promotions/PromotionsBuilderRoutePage.test.tsx src/operations/providerCertification/providerCertificationReadiness.test.ts src/operations/providerCertification/ProviderCertificationReadinessPanel.test.tsx src/operations/mediaManagement/MediaManagementDashboardRoutePage.test.tsx",
    "test:watch": "vitest",
    "verify:commerce": "npm run typecheck && npm run test:commerce",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nodics/nodics.axis.git"
  },
  "bugs": {
    "url": "https://github.com/Nodics/nodics.axis/issues"
  },
  "homepage": "https://github.com/Nodics/nodics.axis#readme",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.2.0",
    "@tanstack/react-query": "5.101.4",
    "intl-messageformat": "^11.2.13",
    "mermaid": "^11.12.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
